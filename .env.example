PORT=4173
# Set when running behind a reverse proxy so devices are grouped by their real address.
TRUST_PROXY=

# Optional relay (TURN) so devices on different networks can connect.
# Either Cloudflare Realtime TURN:
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Or any TURN server with fixed credentials (comma-separated URLs):
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
